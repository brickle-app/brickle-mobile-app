{
  "expo": {
    "name": "Brickle",
    "slug": "brickle",
    "developmentClient": {},
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon.png",
    "scheme": "brickle",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "buildNumber": "98",
      "associatedDomains": [
        "applinks:brickle.app"
      ],
      "bundleIdentifier": "com.brickle.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera for KYC verification and document scanning.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photos to upload documents for KYC verification.",
        "NSFaceIDUsageDescription": "This app uses Face ID for secure authentication.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleDarkContent",
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.brickle.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "brickle.app",
              "pathPrefix": "/redirect-handler"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "autoVerify": true
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "brickle",
              "host": "redirect-handler"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1C3647",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#1C3647"
          },
          "ios": {
            "resizeMode": "contain",
            "backgroundColor": "#1C3647"
          },
          "android": {
            "resizeMode": "contain",
            "backgroundColor": "#1C3647"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/splash-icon.png",
          "color": "#1C3647",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "LibreFranklin-Light",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/libre-franklin/300Light/LibreFranklin_300Light.ttf",
                    "style": "normal",
                    "weight": 300
                  }
                ]
              },
              {
                "fontFamily": "LibreFranklin-Regular",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/libre-franklin/400Regular/LibreFranklin_400Regular.ttf",
                    "style": "normal",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "LibreFranklin-Bold",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/libre-franklin/700Bold/LibreFranklin_700Bold.ttf",
                    "style": "normal",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/libre-franklin/300Light/LibreFranklin_300Light.ttf",
              "node_modules/@expo-google-fonts/libre-franklin/400Regular/LibreFranklin_400Regular.ttf",
              "node_modules/@expo-google-fonts/libre-franklin/700Bold/LibreFranklin_700Bold.ttf","node_modules/@expo-google-fonts/libre-franklin/500Medium/LibreFranklin_500Medium.ttf"
            ]
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ],
      "expo-web-browser",
      "expo-camera",
      "expo-image-picker",
      "expo-file-system"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a76277aa-5341-455f-8ce1-2253b16c81c8"
      }
    }
  }
}
