# Google Sign-In (Platform-specific Client IDs from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="your-ios-client-id.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID="your-android-client-id.apps.googleusercontent.com"

# Brickle API
EXPO_PUBLIC_BRICKLE_API_URL="http://localhost:5001"

# Polygon RPC (Alchemy or your provider)
EXPO_PUBLIC_POLYGON_RPC="https://polygon-amoy.g.alchemy.com/v2/your-api-key"

# Firebase Google Services JSON (base64 encoded — generated from `base64 -i google-services.json`)
GOOGLE_SERVICES_JSON=""